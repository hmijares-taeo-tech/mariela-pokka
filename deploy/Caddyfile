marielapokka.com, www.marielapokka.com {
    encode zstd gzip

    # 1. Imágenes de alta resolución servidas directamente por Caddy con caché inmutable
    handle_path /catalog-images/* {
        root * /srv/catalog-images
        header Cache-Control "public, max-age=31536000, immutable"
        header Access-Control-Allow-Origin "*"
        file_server
    }

    # 2. Endpoints de Medusa.js v2 (Store API, Admin API, Auth y Panel Admin /app)
    handle /store/* {
        reverse_proxy backend:9000
    }

    handle /admin/* {
        reverse_proxy backend:9000
    }

    handle /auth/* {
        reverse_proxy backend:9000
    }

    handle /app* {
        reverse_proxy backend:9000
    }

    handle /health {
        reverse_proxy backend:9000
    }

    # 3. Storefront React + Vite (SPA fallback a index.html)
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}

